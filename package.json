{
  "name": "pi-spawn",
  "version": "0.1.0",
  "description": "Pi extension: spawn subagent sessions. A subagent is a pi session whose parent is another session.",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "keywords": [
    "pi-package",
    "subagents",
    "agents"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typebox": "^1.3.27",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pi-ecosystem/pi-spawn.git"
  }
}
