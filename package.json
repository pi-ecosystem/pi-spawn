{
  "name": "pi-jobs",
  "version": "0.1.0",
  "description": "Pi extension: persistent cross-platform job scheduler. Run any shell command as a tracked, session-mapped background job.",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "jobs",
    "scheduler",
    "background"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.ts",
    "README.md",
    "JOBS.md",
    "LICENSE",
    "skills/"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills/pi-jobs"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@earendil-works/pi-tui": "^1.3.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typebox": "^1.3.27",
    "typescript": "^5.6.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pi-ecosystem/pi-jobs.git"
  }
}
